# Optional: enables AI-written briefs through Vercel AI Gateway.
# Without these, CareBridge uses its built-in template (nothing leaves the browser).
# Choose any chat model from https://vercel.com/ai-gateway/models
AI_GATEWAY_MODEL=google/gemini-2.5-flash-lite
# Locally: export AI_GATEWAY_API_KEY. On Vercel, VERCEL_OIDC_TOKEN is provided automatically.
# AI_GATEWAY_API_KEY=
